#!/bin/sh
set -eu

# Run from the repository root, even if invoked from a subdirectory.
cd "$(git rev-parse --show-toplevel)"

python3 - <<'PY'
from pathlib import Path
import re

build_file = Path("build.txt")
build = int(build_file.read_text().strip())
build_file.write_text(f"{build + 1}\n")

pack_file = Path("pack.toml")
lines = pack_file.read_text().splitlines(keepends=True)

if len(lines) < 3:
    raise SystemExit("pack.toml has fewer than three lines")

line = lines[2]
ending = "\r\n" if line.endswith("\r\n") else "\n" if line.endswith("\n") else ""
match = re.fullmatch(r'(\s*version\s*=\s*")(\d+)("\s*(?:#.*)?\s*)', line.rstrip("\r\n"))

if not match:
    raise SystemExit('Third line of pack.toml must be version = "N"')

lines[2] = f"{match.group(1)}{int(match.group(2)) + 1}{match.group(3)}{ending}"
pack_file.write_text("".join(lines))
PY

git add -- build.txt pack.toml
git commit -m "Increment build and pack version"
git push "$@"
